---
import { url } from '../lib/url';
interface Props { title: string; lead?: string; crumbs?: { label: string; href: string }[]; image?: string }
const { title, lead, crumbs = [], image } = Astro.props;
---
<section class:list={['page-hero', { 'has-image': image }]} style={image ? `--hero-img: url('${url(image)}')` : undefined}>
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Brotkrümel">
        <a href={url('/')}>Start</a>
        {crumbs.map((c) => <><span aria-hidden="true">/</span><a href={url(c.href)}>{c.label}</a></>)}
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .has-image { background-image: linear-gradient(100deg, rgb(165 15 20 / 92%) 0%, rgb(215 20 26 / 70%) 55%, rgb(215 20 26 / 25%) 100%), var(--hero-img); background-size: cover; background-position: center 35%; padding: clamp(56px, 10vw, 120px) 0; }
</style>
