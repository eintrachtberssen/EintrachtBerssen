---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props { id: string; crumbs?: { label: string; href: string }[]; lead?: string }
const { id, crumbs = [], lead } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) throw new Error(`Seite ${id} fehlt in src/content/pages`);
const { Content } = await render(entry);
---
<Base title={entry.data.title}>
  <PageHero title={entry.data.title} crumbs={crumbs} lead={lead} />
  <section class="section">
    <div class="container"><div class="prose"><Content /></div><slot /></div>
  </section>
</Base>
