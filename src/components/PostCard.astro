---
import { formatDate, excerpt } from '../lib/format';
import { url } from '../lib/url';
import type { PostLike } from '../lib/posts';
interface Props { post: PostLike & { body?: string }; featured?: boolean }
const { post, featured = false } = Astro.props;
const { title, date, tags, image } = post.data;
const teaser = excerpt(post.body, featured ? 220 : 130);
---
<article class:list={['post-card', { featured, 'no-image': !image }]}>
  <a href={url(`/beitrag/${post.id}/`)} class="media" tabindex="-1" aria-hidden="true">
    {image ? <img src={url(image)} alt="" loading="lazy" decoding="async" /> : <span class="placeholder"><img src={url('/images/site/wappen.png')} alt="" /></span>}
  </a>
  <div class="content">
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags[0] && <span class="tag">{tags[0]}</span>}
    </div>
    <h3><a href={url(`/beitrag/${post.id}/`)}>{title}</a></h3>
    {teaser && <p>{teaser}</p>}
  </div>
</article>
<style>
  .post-card { position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform 0.2s, box-shadow 0.2s; height: 100%; }
  .post-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .media { display: block; aspect-ratio: 16 / 10; background: var(--bg-2); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .post-card:hover .media img { transform: scale(1.04); }
  .placeholder { display: grid; place-items: center; height: 100%; background: linear-gradient(135deg, var(--red) 0%, var(--red-dark) 100%); }
  .placeholder img { width: 64px; height: auto; opacity: 0.95; object-fit: contain; }
  .post-card:hover .placeholder img { transform: none; }
  .content { padding: 18px 20px 22px; display: flex; flex-direction: column; gap: 8px; }
  .meta { display: flex; gap: 10px; align-items: center; font-size: 0.82rem; color: var(--ink-3); flex-wrap: wrap; }
  .tag { background: var(--red-soft); color: var(--red-dark); padding: 2px 10px; border-radius: 999px; font-weight: 600; }
  h3 { margin: 0; font-size: 1.12rem; overflow-wrap: anywhere; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:hover { color: var(--red); }
  p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  @media (min-width: 900px) {
    .featured { flex-direction: row; grid-column: 1 / -1; }
    .featured .media { flex: 1.3; aspect-ratio: auto; min-height: 340px; }
    .featured .content { flex: 1; padding: 36px; justify-content: center; }
    .featured h3 { font-size: 1.8rem; }
    .featured p { font-size: 1.05rem; }
  }
</style>
