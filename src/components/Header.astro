---
import { NAV, SITE } from '../data/site';
import { url } from '../lib/url';
const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(url(href));
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label={`${SITE.name} – Startseite`}>
      <img src={url('/images/site/wappen.png')} alt="" width="44" height="50" />
      <span><strong>Eintracht</strong> Berssen</span>
    </a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Hauptnavigation">
      <ul>
        {NAV.map((item) => (
          <li class:list={[{ 'has-sub': item.children, active: isActive(item.href) }]}>
            <a href={url(item.href)}>{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={url(c.href)} class:list={[{ active: isActive(c.href) }]}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var b = document.querySelector('.burger');
    var n = document.getElementById('site-nav');
    if (!b || !n) return;
    b.addEventListener('click', function () {
      var open = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      b.setAttribute('aria-label', open ? 'Menü öffnen' : 'Menü schließen');
      n.classList.toggle('open', !open);
      document.body.classList.toggle('nav-open', !open);
    });
  })();
</script>

<style>
  /* Unschärfe auf eigener Ebene: backdrop-filter direkt am Header würde ihn zum Bezugsrahmen
     für das fixierte Handy-Menü machen und dieses auf Header-Höhe abschneiden. */
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); }
  .site-header::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(255 255 255 / 92%); backdrop-filter: saturate(1.4) blur(10px); -webkit-backdrop-filter: saturate(1.4) blur(10px); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font-size: 1.15rem; letter-spacing: -0.01em; }
  .brand img { width: 38px; height: auto; }
  .brand strong { color: var(--red); font-weight: 800; }
  .nav ul { list-style: none; margin: 0; padding: 0; }
  .nav > ul { display: flex; gap: 4px; }
  .nav a { display: block; padding: 8px 14px; border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.97rem; }
  .nav a:hover, .nav .active > a { background: var(--red-soft); color: var(--red-dark); }
  .has-sub { position: relative; }
  .has-sub > a::after { content: ''; display: inline-block; width: 6px; height: 6px; margin-left: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: translateY(-3px) rotate(45deg); opacity: 0.6; }
  .sub { position: absolute; top: 100%; left: 0; min-width: 220px; padding: 8px !important; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-lg); opacity: 0; visibility: hidden; transform: translateY(6px); transition: 0.15s; }
  .sub a { border-radius: var(--radius-sm); font-weight: 550; }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { opacity: 1; visibility: visible; transform: none; }
  .burger { display: none; width: 44px; height: 44px; border: 0; background: transparent; border-radius: 10px; cursor: pointer; padding: 10px; flex-direction: column; justify-content: center; gap: 5px; }
  .burger span { display: block; height: 2px; background: var(--ink); border-radius: 2px; transition: 0.2s; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 899px) {
    .burger { display: flex; }
    .nav { position: fixed; inset: 68px 0 0 0; height: calc(100dvh - 68px); background: #fff; overflow-y: auto; overscroll-behavior: contain; padding: 16px var(--gutter) 40px; display: none; }
    .nav.open { display: block; }
    .nav > ul { flex-direction: column; gap: 2px; }
    .nav > ul > li > a { font-size: 1.15rem; padding: 12px 14px; }
    .has-sub > a::after { display: none; }
    .sub { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 0 0 8px 12px !important; min-width: 0; }
    .sub a { color: var(--ink-2); }
  }
  :global(body.nav-open) { overflow: hidden; }
</style>
