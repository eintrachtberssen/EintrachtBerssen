---
import { url } from '../lib/url';
interface Props { images: string[]; title?: string }
const { images, title = 'Bild' } = Astro.props;
---
{images.length > 0 && (
  <div class="gallery" data-gallery>
    {images.map((src, i) => (
      <a href={url(src)} data-index={i} class="thumb"><img src={url(src)} alt={`${title} – Bild ${i + 1}`} loading="lazy" decoding="async" /></a>
    ))}
  </div>
)}
<style>
  .gallery { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); margin: 24px 0; }
  .thumb { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-sm); background: var(--bg-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .thumb:hover img { transform: scale(1.05); }
</style>
