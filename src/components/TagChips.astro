---
import { slugify } from '../lib/slug';
import { url } from '../lib/url';
interface Props { tags: readonly string[]; active?: string; all?: boolean; small?: boolean }
const { tags, active, all = false, small = false } = Astro.props;
---
<ul class:list={['chips', { small }]}>
  {all && <li><a href={url('/aktuelles/')} class:list={[{ on: !active }]}>Alle</a></li>}
  {tags.map((t) => <li><a href={url(`/aktuelles/tag/${slugify(t)}/`)} class:list={[{ on: active === t }]}>{t}</a></li>)}
</ul>
<style>
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-block; padding: 6px 14px; border-radius: 999px; background: var(--bg-2); color: var(--ink-2); font-size: 0.9rem; font-weight: 600; text-decoration: none; border: 1px solid var(--line); }
  .chips a:hover { border-color: var(--red); color: var(--red); }
  .chips a.on { background: var(--red); border-color: var(--red); color: #fff; }
  .small a { padding: 3px 10px; font-size: 0.78rem; background: var(--red-soft); color: var(--red-dark); border: 0; }
</style>
