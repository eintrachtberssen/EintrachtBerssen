---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import downloads from '../../data/downloads.json';
import { url } from '../../lib/url';
type D = { category: string; title: string; href: string; note?: string };
const list = downloads as D[];
const cats = [...new Set(list.map((d) => d.category))];
const href = (h: string) => (h.startsWith('/') ? url(h) : h);
---
<Base title="Downloads">
  <PageHero title="Downloads" lead="Mitglied werden? Hier findest du alle Anträge und Dokumente." crumbs={[{ label: 'Verein', href: '/verein/' }]} />
  <section class="section">
    <div class="container cats">
      {cats.map((c) => (
        <div>
          <h2>{c}</h2>
          <ul class="files">
            {list.filter((d) => d.category === c).map((d) => (
              <li>
                <a class="file card" href={href(d.href)} download={d.href.startsWith('/') ? '' : undefined}>
                  <span class="ico" aria-hidden="true">PDF</span>
                  <span><strong>{d.title}</strong>{d.note && <small>{d.note}</small>}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .cats { display: grid; gap: 40px; }
  .files { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .file { display: flex; gap: 16px; align-items: center; padding: 18px; text-decoration: none; color: var(--ink); transition: 0.15s; }
  .file:hover { border-color: var(--red); }
  .ico { flex: none; width: 48px; height: 56px; border-radius: 6px; background: var(--red-soft); color: var(--red-dark); font-weight: 800; font-size: 0.75rem; display: grid; place-items: center; }
  small { display: block; color: var(--ink-2); }
</style>
