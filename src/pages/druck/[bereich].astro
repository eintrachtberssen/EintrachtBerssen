---
// Druckansicht des Belegungsplans (A4 quer) – Quelle für die PDFs (scripts/belegung-pdf.mjs).
import '@fontsource-variable/inter';
import raw from '../../data/belegung.json';
import { belegungSchema, DAYS, assignLanes, axisRange, toMinutes, teamKind, clubKey, type Entry, type Day } from '../../lib/belegung';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return [{ params: { bereich: 'platz' } }, { params: { bereich: 'halle' } }];
}
const mode = Astro.params.bereich as 'platz' | 'halle';
const data = belegungSchema.parse(raw);
const area = mode === 'platz' ? data.platz : data.halle;
const entries = area.entries;
const days = DAYS.filter((d, i) => i < 5 || entries.some((e) => e.day === d)) as Day[];
const [h0, h1] = axisRange(entries);
const span = (h1 - h0) * 60;
const hours = Array.from({ length: h1 - h0 + 1 }, (_, i) => h0 + i);

// Unterspalten je Tag: Fußball nach Platz, Halle eine Spalte
const placesOf = (day: Day) =>
  mode === 'platz' ? [...new Set(entries.filter((e) => e.day === day).map((e) => e.place ?? '–'))].sort() : [''];
const allPlaces = mode === 'platz' ? [...new Set(entries.map((e) => e.place ?? '–'))].sort() : [''];
const cols = days.map((day) => ({
  day,
  places: (mode === 'platz' ? allPlaces : placesOf(day)).map((place) => {
    const list = entries.filter((e) => e.day === day && (mode === 'halle' || (e.place ?? '–') === place));
    return { place, ...assignLanes(list) };
  }),
}));
const color = (e: Entry) => (mode === 'platz' ? teamKind(e.team) : /^(belegt|schulsport)$/i.test(e.team) ? 'blocked' : clubKey(e.club));
const top = (e: Entry) => ((toMinutes(e.from) - h0 * 60) / span) * 100;
const height = (e: Entry) => ((toMinutes(e.to) - toMinutes(e.from)) / span) * 100;
const title = mode === 'platz' ? 'Belegungsplan Fußballplätze' : `Belegungsplan ${area.title ?? 'Turnhalle'}`;
const stand = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Europe/Berlin' }).format(new Date());
const site = new URL(url('/verein/belegungsplan/'), Astro.site).href.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <style>
    @page { size: A4 landscape; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: #fff; }
    body { font-family: 'Inter Variable', system-ui, sans-serif; color: #16181d; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .page { width: 297mm; height: 210mm; padding: 9mm 10mm 8mm; display: flex; flex-direction: column; gap: 4mm; overflow: hidden; }
    header { display: flex; align-items: center; gap: 4mm; border-bottom: 0.6mm solid #d7141a; padding-bottom: 3mm; }
    header img { width: 13mm; height: auto; }
    .club { font-size: 9pt; font-weight: 700; color: #d7141a; text-transform: uppercase; letter-spacing: 0.06em; }
    h1 { margin: 0.5mm 0 0; font-size: 19pt; letter-spacing: -0.02em; line-height: 1.1; }
    .right { margin-left: auto; text-align: right; font-size: 8.5pt; color: #4a4f5a; }
    .season { display: inline-block; background: #d7141a; color: #fff; font-weight: 800; font-size: 10pt; padding: 1mm 3mm; border-radius: 10mm; margin-bottom: 1mm; }
    .intro { margin: 0; font-size: 9pt; color: #4a4f5a; }

    .plan { flex: 1; display: grid; grid-template-columns: 12mm repeat(var(--days), 1fr); grid-template-rows: auto 1fr; column-gap: 1.5mm; min-height: 0; }
    .dayhead { text-align: center; font-weight: 800; font-size: 10pt; padding: 1.5mm 0; background: #f6f6f8; border-radius: 1.5mm 1.5mm 0 0; }
    .subhead { display: flex; font-size: 7pt; font-weight: 700; color: #4a4f5a; }
    .subhead span { flex: 1; text-align: center; border-top: 0.2mm solid #e2e3e8; padding-top: 0.6mm; }
    .axis, .col { position: relative; }
    .axis span { position: absolute; right: 1.5mm; transform: translateY(-50%); font-size: 7.5pt; font-weight: 700; color: #7b8190; font-variant-numeric: tabular-nums; }
    .col { display: flex; gap: 0.8mm; background: repeating-linear-gradient(to bottom, #e7e8ec 0 0.2mm, transparent 0.2mm calc(100% / var(--hours))); border-left: 0.2mm solid #e7e8ec; border-right: 0.2mm solid #e7e8ec; border-bottom: 0.2mm solid #e7e8ec; }
    .place { position: relative; flex: 1; }
    .place + .place { border-left: 0.2mm dashed #d0d2d8; }
    .slot { position: absolute; border-radius: 1.2mm; padding: 0.8mm 1.2mm; overflow: hidden; border-left: 0.9mm solid #7b8190; background: #f1f2f4; line-height: 1.15; }
    .slot b { display: block; font-size: 7.6pt; }
    .slot small { display: block; font-size: 6.4pt; color: #4a4f5a; font-variant-numeric: tabular-nums; }
    .slot.narrow { padding: 0.8mm 0.8mm; }
    .slot.narrow b { font-size: 6.6pt; letter-spacing: -0.01em; }
    .slot.narrow small { font-size: 6pt; }
    .jugend, .hueven { border-left-color: #3f9a3a; background: #e4f2e2; }
    .senioren, .stavern { border-left-color: #2f6fd6; background: #e2ecfb; }
    .berssen { border-left-color: #d7141a; background: #fbe3e3; }
    .blocked { border-left-color: #b8bcc6; background: repeating-linear-gradient(135deg, #f1f2f4 0 1.5mm, #e8e9ec 1.5mm 3mm); color: #7b8190; }

    footer { display: flex; gap: 6mm; align-items: flex-start; font-size: 7.6pt; color: #4a4f5a; border-top: 0.2mm solid #e7e8ec; padding-top: 2.5mm; }
    .legend { display: flex; gap: 4mm; flex-wrap: wrap; flex: none; }
    .legend span { display: inline-flex; align-items: center; gap: 1.5mm; font-weight: 600; }
    .legend i { width: 3mm; height: 3mm; border-radius: 0.6mm; display: inline-block; }
    .notes { margin: 0; padding-left: 4mm; flex: 1; }
    .notes li { margin-bottom: 0.6mm; }
    .meta { margin-left: auto; text-align: right; flex: none; }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <img src={url('/images/site/wappen.png')} alt="" />
      <div>
        <div class="club">{SITE.legalName}</div>
        <h1>{title}</h1>
        {area.intro && <p class="intro">{area.intro}</p>}
      </div>
      <div class="right">
        {area.season && <div class="season">{area.season}</div>}
        <div>Stand: {stand}</div>
      </div>
    </header>

    <div class="plan" style={`--days: ${days.length}; --hours: ${h1 - h0}`}>
      <div></div>
      {cols.map((c) => (
        <div>
          <div class="dayhead">{c.day}</div>
          {mode === 'platz' && <div class="subhead">{c.places.map((p) => <span style={`flex: ${Math.max(p.lanes, 1) + 1}`}>{p.place}</span>)}</div>}
        </div>
      ))}
      <div class="axis">{hours.map((h, i) => <span style={`top: ${(i / (h1 - h0)) * 100}%`}>{String(h).padStart(2, '0')}:00</span>)}</div>
      {cols.map((c) => (
        <div class="col">
          {c.places.map((p) => (
            <div class="place" style={`flex: ${Math.max(p.lanes, 1) + 1}`}>
              {p.items.map(({ entry: e, lane }) => (
                <div class:list={['slot', color(e), { narrow: p.lanes > 1 }]} style={`top: ${top(e)}%; height: calc(${height(e)}% - 0.6mm); left: calc(${(lane / p.lanes) * 100}% + 0.4mm); width: calc(${100 / p.lanes}% - 0.8mm)`}>
                  <b>{e.team}</b>
                  <small>{e.from}–{e.to}{mode === 'halle' && e.club && e.club !== e.team && e.club !== 'Schule' ? ` · ${e.club}` : ''}{e.note ? ` · ${e.note}` : ''}</small>
                </div>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>

    <footer>
      <div class="legend">
        {mode === 'platz' ? (
          <><span><i class="jugend"></i>Junioren & Juniorinnen</span><span><i class="senioren"></i>Herren & Damen</span></>
        ) : (
          <><span><i class="berssen"></i>Eintracht Berssen</span><span><i class="hueven"></i>SV Eisten/Hüven</span><span><i class="stavern"></i>SV Stavern</span></>
        )}
      </div>
      {area.notes.length > 0 && <ul class="notes">{area.notes.map((n) => <li>{n}</li>)}</ul>}
      <div class="meta">Immer aktuell online:<br /><b>{site}</b></div>
    </footer>
  </div>
</body>
</html>
