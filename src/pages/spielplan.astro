---
// Der Spielplan ist auf die Fußball-Seite umgezogen; alte Links leiten dorthin weiter.
import { url } from '../lib/url';
const target = url('/sport/fussball/#spielplan');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Spielplan</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body><p>Der Spielplan ist jetzt auf der <a href={target}>Fußball-Seite</a>.</p></body>
</html>
