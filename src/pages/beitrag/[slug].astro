---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Gallery from '../../components/Gallery.astro';
import TagChips from '../../components/TagChips.astro';
import { getPosts, type Post } from '../../lib/content';
import { postsForTags } from '../../lib/posts';
import { formatDate, excerpt } from '../../lib/format';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content } = await render(post);
const { title, date, tags, image, gallery } = post.data;
// Titelbild nicht doppelt zeigen, wenn es schon im Text oder in der Galerie steht
const showCover = image && !post.body?.includes(image) && !gallery.includes(image);
const related = postsForTags(posts.filter((p) => p.id !== post.id), tags.filter((t) => t !== 'Fußball' && t !== 'Verein').length ? tags.filter((t) => t !== 'Fußball' && t !== 'Verein') : tags).slice(0, 3);
---
<Base title={title} description={excerpt(post.body, 160)} image={image ? url(image) : undefined}>
  <article>
    <header class="post-head">
      <div class="container narrow">
        <a class="back" href={url('/aktuelles/')}>← Alle Beiträge</a>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <h1>{title}</h1>
        {tags.length > 0 && <TagChips tags={tags} small />}
      </div>
    </header>
    {showCover && <div class="container narrow"><img class="cover" src={url(image!)} alt="" /></div>}
    <div class="container narrow body prose">
      <Content />
      <Gallery images={gallery} title={title} />
    </div>
  </article>
  {related.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head"><h2>Das könnte dich auch interessieren</h2></div>
        <PostList posts={related} />
      </div>
    </section>
  )}
</Base>
<style>
  .narrow { max-width: 820px; }
  .post-head { padding: clamp(32px, 6vw, 64px) 0 24px; }
  .back { display: inline-block; margin-bottom: 20px; font-weight: 600; text-decoration: none; font-size: 0.92rem; }
  time { display: block; color: var(--ink-3); font-weight: 600; font-size: 0.92rem; margin-bottom: 8px; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); overflow-wrap: anywhere; }
  .cover { width: 100%; border-radius: var(--radius); margin-bottom: 24px; max-height: 560px; object-fit: cover; }
  .body { padding-bottom: 64px; font-size: 1.06rem; }
  .prose { max-width: none; }
</style>
