---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Seite nicht gefunden">
  <section class="section"><div class="container">
    <span class="eyebrow">Fehler 404</span>
    <h1>Abseits!</h1>
    <p>Diese Seite gibt es (nicht mehr). Vielleicht findest du es hier:</p>
    <p><a class="btn" href={url('/')}>Zur Startseite</a> <a class="btn btn--ghost" href={url('/aktuelles/')}>Aktuelles</a></p>
  </div></section>
</Base>
